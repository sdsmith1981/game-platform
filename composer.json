{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sdsmith1981/game-platform",
    "type": "library",
    "description": "Shared platform for sdsmith1981's browser games: social login, play-time billing, saves, offline play and ops.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/fortify": "^1.37.2",
        "laravel/socialite": "^5.31"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "GamePlatform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GamePlatform\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "lint": "pint --parallel",
        "test": [
            "pint --parallel --test",
            "phpstan analyse --memory-limit=1G",
            "pest"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "GamePlatform\\GamePlatformServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
